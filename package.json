{
  "name": "autoclicker-for-mac",
  "version": "1.4.0",
  "description": "A fast, free autoclicker for macOS",
  "main": "src/main.js",
  "scripts": {
    "build:native": "sh native/build.sh",
    "prestart": "npm run build:native",
    "start": "electron .",
    "pretest": "npm run build:native",
    "test": "node --test \"test/*.test.js\"",
    "predist": "npm run build:native",
    "dist": "electron-builder --mac"
  },
  "keywords": [
    "autoclicker",
    "mac",
    "electron"
  ],
  "author": "erikkostashuk",
  "license": "MIT",
  "repository": "github:erikkostashuk/autoclicker-for-mac",
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.erikkostashuk.autoclicker",
    "productName": "AutoClicker for Mac",
    "files": [
      "src/**/*"
    ],
    "extraResources": [
      {
        "from": "native/build/clicker",
        "to": "clicker"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "logo/1024-mac.png",
      "identity": "-",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "AutoClicker-for-Mac-${version}-${arch}.${ext}",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "AutoClicker for Mac",
      "writeUpdateInfo": false
    },
    "publish": null
  },
  "allowScripts": {
    "electron-winstaller": false
  }
}
